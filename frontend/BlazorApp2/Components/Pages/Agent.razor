@page "/agent"
@rendermode InteractiveServer


@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.Encodings.Web

@inject IHttpClientFactory ClientFactory

<h1>InsightAgent 数据分析智能体</h1>

<p class="hint">
    上传 CSV 后，可以通过自然语言让 Agent 完成数据分析、图表生成和报告生成。
</p>

<div class="agent-layout">

    <section class="card-panel">
        <h3>1. 数据上传</h3>

        <InputFile OnChange="UploadCsv" accept=".csv" />

        @if (!string.IsNullOrWhiteSpace(uploadStatus))
        {
            <div class="status-box">
                @uploadStatus
            </div>
        }

        <p class="hint">
            后端接口：POST http://127.0.0.1:8000/upload
        </p>
    </section>

    <section class="card-panel">
        <h3>2. 快捷分析</h3>

        <div class="quick-buttons">
            @foreach (var item in quickQuestions)
            {
                <button class="quick-btn" @onclick="() => SendQuickQuestion(item)">
                    @item
                </button>
            }
        </div>
    </section>

    <section class="card-panel">
        <h3>3. 智能问答</h3>

        <textarea class="question-box"
                  @bind="question"
                  placeholder="例如：生成分析报告 / 检测异常销售额 / 月度销售趋势 / 哪个区域销售额最高">
        </textarea>

        <div class="actions">
            <button class="primary-btn" @onclick="AskAgent" disabled="@isBusy">
                @(isBusy ? "分析中..." : "发送")
            </button>

            <button class="secondary-btn" @onclick="ClearAnswer">
                清空结果
            </button>
        </div>
    </section>

    <section class="card-panel">
        <h3>4. Agent 回复</h3>

        @if (!string.IsNullOrWhiteSpace(answer))
        {
            <div class="result-block">
                <h4>Answer</h4>
                <pre>@answer</pre>
            </div>

            <div class="meta-grid">
                <div>
                    <strong>tool_used：</strong>
                    <span>@toolUsed</span>
                </div>

                <div>
                    <strong>intent：</strong>
                    <span>@intent</span>
                </div>
            </div>
        }
        else
        {
            <p class="hint">暂无回复。</p>
        }

        @if (!string.IsNullOrWhiteSpace(rawResponse))
        {
            <details>
                <summary>查看原始 JSON</summary>
                <pre>@rawResponse</pre>
            </details>
        }
    </section>

    <section class="card-panel">
        <h3>5. 报告与图表</h3>

        <div class="actions">
            <button class="primary-btn" @onclick="GenerateReport">
                生成报告
            </button>

            <button class="secondary-btn" @onclick="GenerateCharts">
                生成图表
            </button>

            <a ...>
            @ReportUrl
                下载报告
            </a>
        </div>

        <p class="hint">
            如果图表没有显示，先点击“生成图表”或“生成报告”。
        </p>

        <div class="chart-grid">

            <div class="chart-card">
                <h4>区域销售图</h4>
                @RegionChartUrl
            </div>

            <div class="chart-card">
                <h4>品类销售图</h4>
                @CategoryChartUrl
            </div>

            <div class="chart-card">
                <h4>渠道销售图</h4>
                @ChannelChartUrl
            </div>

            <div class="chart-card">
                <h4>月度趋势图</h4>
                @MonthlyTrendChartUrl
            </div>

        </div>
    </section>

</div>

@code {
    private readonly string apiBaseUrl = "http://127.0.0.1:8000";

    private string question = "";
    private string answer = "";
    private string toolUsed = "";
    private string intent = "";
    private string rawResponse = "";
    private string uploadStatus = "";
    private bool isBusy = false;

    private long chartVersion = DateTimeOffset.Now.ToUnixTimeMilliseconds();

    private string ReportUrl => $"{apiBaseUrl}/report";

    private string RegionChartUrl => ChartUrl("region_sales.png");

    private string CategoryChartUrl => ChartUrl("category_sales.png");

    private string ChannelChartUrl => ChartUrl("channel_sales.png");

    private string MonthlyTrendChartUrl => ChartUrl("monthly_sales_trend.png");

    private readonly List<string> quickQuestions = new()
    {
        "数据概览",
        "核心指标总览",
        "数据质量怎么样",
        "哪个区域销售额最高",
        "品类销售分析",
        "渠道销售分析",
        "月度销售趋势",
        "利润率是多少",
        "检测异常销售额",
        "生成图表",
        "生成分析报告"
    };

    private async Task UploadCsv(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file is null)
            {
                uploadStatus = "没有选择文件。";
                return;
            }

            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                uploadStatus = "目前只支持 CSV 文件。";
                return;
            }

            var client = ClientFactory.CreateClient();

            using var form = new MultipartFormDataContent();

            var maxAllowedSize = 20 * 1024 * 1024;

            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("text/csv");

            form.Add(fileContent, "file", file.Name);

            var response = await client.PostAsync($"{apiBaseUrl}/upload", form);
            var responseText = await response.Content.ReadAsStringAsync();

            uploadStatus = response.IsSuccessStatusCode
                ? $"上传完成：{file.Name}\n{responseText}"
                : $"上传失败：{response.StatusCode}\n{responseText}";
        }
        catch (Exception ex)
        {
            uploadStatus = $"上传异常：{ex.Message}";
        }
    }

    private async Task SendQuickQuestion(string text)
    {
        question = text;
        await AskAgent();
    }

    private async Task GenerateReport()
    {
        await SendQuickQuestion("生成分析报告");
    }

    private async Task GenerateCharts()
    {
        await SendQuickQuestion("生成图表");
    }

    private async Task AskAgent()
    {
        if (string.IsNullOrWhiteSpace(question))
        {
            answer = "请先输入问题。";
            return;
        }

        try
        {
            isBusy = true;

            var client = ClientFactory.CreateClient();

            var request = new ChatRequest
            {
                Question = question
            };

            var response = await client.PostAsJsonAsync($"{apiBaseUrl}/chat", request);
            rawResponse = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                answer = $"请求失败：{response.StatusCode}\n{rawResponse}";
                return;
            }

            using var document = JsonDocument.Parse(rawResponse);
            var root = document.RootElement;

            answer = ReadJsonProperty(root, "answer");
            toolUsed = ReadJsonProperty(root, "tool_used");
            intent = ReadJsonProperty(root, "intent");

            chartVersion = DateTimeOffset.Now.ToUnixTimeMilliseconds();
        }
        catch (Exception ex)
        {
            answer = $"调用 Agent 失败：{ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string ReadJsonProperty(JsonElement root, string propertyName)
    {
        if (!root.TryGetProperty(propertyName, out var property))
        {
            return "";
        }

        if (property.ValueKind == JsonValueKind.String)
        {
            return property.GetString() ?? "";
        }

        return JsonSerializer.Serialize(
            property,
            new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            }
        );
    }

    private string ChartUrl(string chartName)
    {
        return $"{apiBaseUrl}/charts/{chartName}?v={chartVersion}";
    }

    private void ClearAnswer()
    {
        answer = "";
        toolUsed = "";
        intent = "";
        rawResponse = "";
    }

    private class ChatRequest
    {
        [JsonPropertyName("question")]
        public string Question { get; set; } = "";
    }
}

<style>
    .agent-layout {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1100px;
    }

    .card-panel {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 20px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .question-box {
        width: 100%;
        min-height: 100px;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 15px;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .primary-btn {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 9px 16px;
        cursor: pointer;
    }

    .primary-btn:disabled {
        background: #93c5fd;
        cursor: not-allowed;
    }

    .secondary-btn {
        background: #f3f4f6;
        color: #111827;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 9px 16px;
        cursor: pointer;
    }

    .download-btn {
        display: inline-block;
        background: #059669;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        padding: 9px 16px;
    }

    .quick-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .quick-btn {
        background: #eef2ff;
        color: #3730a3;
        border: 1px solid #c7d2fe;
        border-radius: 999px;
        padding: 8px 13px;
        cursor: pointer;
    }

    .status-box {
        white-space: pre-wrap;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        margin-top: 12px;
    }

    .result-block {
        background: #f9fafb;
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #e5e7eb;
    }

    pre {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 12px;
    }

    .chart-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 16px;
    }

    .chart-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 12px;
        background: #f9fafb;
    }

    .chart-card img {
        width: 100%;
        max-height: 360px;
        object-fit: contain;
        border-radius: 8px;
        background: white;
    }

    .hint {
        color: #6b7280;
        font-size: 14px;
        margin-top: 8px;
    }
</style>